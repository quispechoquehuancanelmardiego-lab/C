#include <stdio.h>

int main () {
	//definir varible
	int numero1, numero2;
	int suma, resta, multiplicacion, division;
	//entrada
	printf( "ingrese el numero 1 y el numero 2 para realizar las cuatros operaciones suma, resta, multiplicacion y divicion :) \n");
	printf("ingrese el numero 1: ");
	scanf("%d", &numero1);
	printf ("ingrese el numero 2: ");
	scanf("%d", &numero2);
	//proceso
	suma=numero1+numero2;
	resta=numero1-numero2;
	multiplicacion=numero1*numero2;
	division = numero1 / numero2;
	//salida
	printf ("el resultado de la suma es: %d\n", suma);
	printf ("el resultado de la resta es: %d\n", resta);
	printf ("el resultado de la multiplicacion es: %d\n", multiplicacion);
	printf( "El resultado de la division es:  %d\n", division);
	
	return 0;
	}
